{
  "name": "forgepad",
  "version": "0.1.0",
  "private": true,
  "productName": "ForgePad",
  "bundleIdentifier": "com.forgepad.app",
  "description": "Terminal-first AI coding workspace with Pierre diffs and trees.",
  "type": "module",
  "scripts": {
    "dev": "sh -c 'pnpm exec vite --host 127.0.0.1 & renderer_pid=$!; trap \"kill $renderer_pid 2>/dev/null\" EXIT INT TERM; sleep 1; cd native/macos/ForgePadHost && FORGEPAD_WEB_URL=http://127.0.0.1:1420 FORGEPAD_CORE_COMMAND=\"cargo run --manifest-path ../../../crates/forgepad-core/Cargo.toml --bin forgepad-core-daemon\" swift run'",
    "build": "pnpm typecheck && cargo test --manifest-path crates/forgepad-core/Cargo.toml && node scripts/package-native-mac.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint src/",
    "format": "biome format --write src/",
    "check": "biome check src/",
    "check:write": "biome check --write src/"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/modifiers": "^9.0.0",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@fontsource-variable/inter": "^5.2.8",
    "@pierre/diffs": "1.1.15",
    "@pierre/trees": "^1.0.0-beta.3",
    "@streamdown/code": "^1.1.1",
    "@streamdown/mermaid": "^1.0.2",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "allotment": "^1.20.4",
    "clsx": "^2.1.1",
    "codex-pets-react": "^0.2.0",
    "lucide-react": "^0.577.0",
    "mermaid": "^11.14.0",
    "motion": "^12.38.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "streamdown": "^2.5.0",
    "unicode-animations": "^1.0.3",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.13",
    "@tailwindcss/vite": "^4.2.4",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.13",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "tailwindcss": "^4.2.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7"
  },
  "repository": "git@github.com:zxpzdtom/forgepad.git"
}
