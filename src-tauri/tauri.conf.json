{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ForgePad",
  "version": "0.1.0",
  "identifier": "com.forgepad.app",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist/renderer",
    "removeUnusedCommands": false
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ForgePad",
        "width": 1420,
        "height": 920,
        "minWidth": 980,
        "minHeight": 640,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": true,
        "backgroundColor": "#0f1115",
        "trafficLightPosition": {
          "x": 14,
          "y": 17
        }
      }
    ],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Terminal-first AI coding workspace",
    "longDescription": "ForgePad is a terminal-first AI coding workspace with diffs, trees, terminal tabs and context bundles.",
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "resources": {
      "../build/app-icons/*.png": "app-icons/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ]
  }
}
